{
  "version": "2.0.0",
  "options": {
    "env": {
      "D": "/media/tshino/DATA/workspace/2026_aqp4ko_water_intoxication/2photon/20260803_sub-sk28_ses-01",
      "SUB": "sk28",
      "IVWIB_REPO": "/media/tshino/DATA/Projects/in_vivo_water_imaging_brain"
    }
  },
  "presentation": {
    "reveal": "always",
    "panel": "dedicated",
    "clear": true
  },
  "tasks": [
    {
      "label": "0 | metadata (ivwib)",
      "type": "shell",
      "command": "conda run -n ivwib --no-capture-output python ${env:IVWIB_REPO}/scripts/generate_metadata.py ${env:D}/",
      "problemMatcher": []
    },
    {
      "label": "1 | suite2p series (dry-run)",
      "type": "shell",
      "command": "conda run -n caimg --no-capture-output python run_suite2p_series.py --dataset ${env:D} --pattern 'sub-${env:SUB}_ses-01_cond-*_run-*.tif' --functional-chan 1 --dry-run",
      "problemMatcher": []
    },
    {
      "label": "2 | suite2p series (register + detect, ONE run)",
      "type": "shell",
      "command": "conda run -n caimg --no-capture-output python run_suite2p_series.py --dataset ${env:D} --pattern 'sub-${env:SUB}_ses-01_cond-*_run-*.tif' --functional-chan 1 --torch-device cuda --algorithm cellpose --cellpose-img meanImg",
      "problemMatcher": []
    },
    {
      "label": "3 | feasibility QC",
      "type": "shell",
      "command": "conda run -n caimg --no-capture-output python qc_feasibility.py --s2p-dir ${env:D}/work/s2p_series/suite2p/plane0 --dataset ${env:D} --out ${env:D}/work/qc_series",
      "problemMatcher": []
    },
    {
      "label": "4 | AUC",
      "type": "shell",
      "command": "conda run -n caimg --no-capture-output python run_auc.py --s2p-dir ${env:D}/work/s2p_series/suite2p/plane0 --dataset ${env:D} --ledger ${env:D}/work/s2p_series/frame_ledger.csv --out ${env:D}/work/auc",
      "problemMatcher": []
    },
    {
      "label": "5 | ROI traces figure",
      "type": "shell",
      "command": "conda run -n caimg --no-capture-output python fig_roi_traces.py --s2p-dir ${env:D}/work/s2p_series/suite2p/plane0 --dataset ${env:D} --all --per-page 10 --order position --out ${env:D}/work/fig_roi_traces",
      "problemMatcher": []
    },
    {
      "label": "run all (1-5)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "2 | suite2p series (register + detect, ONE run)",
        "3 | feasibility QC",
        "4 | AUC",
        "5 | ROI traces figure"
      ],
      "problemMatcher": []
    }
  ]
}